{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  // Not a secret. Pinning it means CI needs only CLOUDFLARE_API_TOKEN, and a
  // token with access to several accounts cannot pick the wrong one.
  "account_id": "612b695d2a20f2d6e4a59d213577a2f9",

  // SQLite-backed classes are the only kind available on the Workers Free
  // plan. Relay keeps no persistent state, but the class type still matters.
  // install.sh is imported as a string and served at /install.
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],

  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "TunnelHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelHub"] }],

  // Tunnels must sit ONE level below the zone apex. Universal SSL does not
  // cover deeper wildcards, so "demo.tunnels.example.com" would need paid
  // Advanced Certificate Manager, while "demo.example.com" is free.
  // ANONYMOUS lets anyone open a rate-limited tunnel without the token
  // (see docs/cloudflare.md). Self-hosters: remove it to require the token.
  "vars": {
    "ANONYMOUS": "1",
    "CONTROL_HOST": "relay.tnnnnnnnl.xyz",
    "TUNNEL_SUFFIX": "tnnnnnnnl.xyz"
  },

  // One wildcard route covers both the control host and every tunnel.
  // Requires a proxied wildcard DNS record on the zone.
  "routes": [{ "pattern": "*.tnnnnnnnl.xyz/*", "zone_name": "tnnnnnnnl.xyz" }],

  // Set here, not in the dashboard: CI deploys overwrite dashboard changes.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
